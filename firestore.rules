rules_version = '2';

// Fab Fresh Fudge -- who may read and write the admin dashboard's data.
//
// This file is the source of truth. It is live in the Firebase console under
// Firestore -> Rules; after editing it here, paste it there and Publish (or run
// `npx firebase-tools deploy --only firestore:rules --project fab-fresh-site`).
//
// THIS IS THE SECURITY. The dashboard's own checks run in the browser and can
// be bypassed; these cannot.
//   - Anyone may READ flavors, events, packages, pricing and photos: the
//     public site does, and none of it is private.
//   - Only signed-in users whose uid has a document in admins/ may WRITE.
//     Being signed in is not enough on its own.
//   - admins/ can only be edited from the Firebase console.
//   - Everything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
    }

    // Whole dollars and cents, within the limits src/admin/lib/price.js sets.
    // Compared with a tolerance because 7.95 * 100 is not exactly 795 in
    // floating point.
    function isMoney(value, max, allowZero) {
      return (value is int || value is float)
        && (allowZero ? value >= 0 : value > 0)
        && value <= max
        && math.abs(value * 100 - math.round(value * 100)) < 0.000001;
    }

    match /flavors/{id} {
      allow read: if true;
      // The doc id is the flavor's write-once slug; the public site keys off it.
      allow create: if isAdmin() && hasName()
        && id.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
      allow update: if isAdmin() && hasName();
      allow delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && hasName();
      allow delete: if isAdmin();
    }

    match /packages/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && hasName();
      allow delete: if isAdmin();
    }

    // Uploaded flavor photos, stored as bytes because the free plan has no
    // Cloud Storage (served by /api/photo). Never edited: a new photo is a new
    // doc. The dashboard squeezes the full JPEG under 800 KB; these caps only
    // stop abuse, and Firestore's own 1 MiB record limit sits above them.
    match /photos/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && id.matches('^[A-Za-z0-9_-]{8,64}$')
        && request.resource.data.keys().hasOnly(['full', 'thumb', 'contentType', 'width', 'height', 'createdAt'])
        && request.resource.data.full is bytes
        && request.resource.data.full.size() <= 900 * 1024
        && request.resource.data.thumb is bytes
        && request.resource.data.thumb.size() <= 120 * 1024
        && request.resource.data.contentType == 'image/jpeg'
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Decides what customers are charged once the site reads it, so the shape
    // and the numbers are checked here, not just in the dashboard. No delete.
    match /settings/pricing {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['squarePrice', 'boxPrice', 'shippingFee'])
        && request.resource.data.keys().hasAll(['squarePrice', 'boxPrice', 'shippingFee'])
        && isMoney(request.resource.data.squarePrice, 999, false)
        && isMoney(request.resource.data.boxPrice, 9999, false)
        && isMoney(request.resource.data.shippingFee, 999, true);
    }

    // Marks the one-time import of the starting content.
    match /settings/meta {
      allow read, create: if isAdmin();
    }

    // "Something changed since the last publish": stamped on every save, so
    // the dashboard can show unpublished changes on any device.
    match /settings/edits {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['lastEditAt', 'by'])
        && request.resource.data.lastEditAt == request.time;
    }

    // Who may sign in to the dashboard. A user may check their own entry
    // (that is how the dashboard knows to let them in); nobody may write.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
