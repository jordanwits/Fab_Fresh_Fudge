# Checkout configuration.
#
# Local dev: copy this file to .env.local and fill it in; `npm run dev` picks it
# up. Vercel: set the same names under Project > Settings > Environment
# Variables. NEVER commit real values: this repository is public.

# Square access token. Use a Sandbox token locally and on preview deploys; the
# production token belongs only on Vercel's Production environment. Never give
# it a VITE_ prefix, which would publish it inside the site's JavaScript.
SQUARE_ACCESS_TOKEN=

# The Square location online orders are filed under. Sandbox and production
# accounts have different location IDs.
SQUARE_LOCATION_ID=

# sandbox | production. Anything else is treated as sandbox.
SQUARE_ENVIRONMENT=sandbox

# Optional. `open` or `closed` forces checkout on or off regardless of the
# November-April shipping season; leave blank to follow the calendar. Both the
# site build and the checkout function read it, so redeploy after changing it.
VITE_CHECKOUT_SEASON=

# Web3Forms access key for the out-of-season shipping quote form, tied to the
# inbox that should receive those requests. Web3Forms treats this key as
# public, but it stays server-side here so it can't be scraped and abused.
# Without it the form tells people so and offers a prefilled email instead.
WEB3FORMS_ACCESS_KEY=
